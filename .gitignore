# IDE files
/.vscode
/.cache
/_deps

# A-CX tooling (.a-cx/, .claude/, AGENTS.md, CLAUDE.md) is intentionally
# tracked on the acx/dev branch. Upstream ignores these dirs; this branch
# overrides that so the team's tooling commits work with a normal `git add`.
# main stays a clean upstream mirror and must never carry these. Only the
# per-run delivery worktrees stay ignored (see bottom of file).

# Build files
/build
/cmake-build-install
/lib
/third_party/iamf/include/iamf/commit_hash.h
/scripts/package_config.sh

# CTest
/Testing

# The wraptool_helper, which can not be checked in
/scripts/wraptool_helper.sh

.DS_Store

#Windows-specific ignores

#Build artefacts
cmake-build*/
[Bb]in/
obj/

#IDE Config
.vs/
.idea/
CMakeSettings.json


